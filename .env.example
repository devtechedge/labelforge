# PostgreSQL connection string. SSL is required by hosted providers.
DATABASE_URL="postgresql://labelforge:labelforge@localhost:55432/labelforge?schema=public"

# Public origin used for origin checks and generated links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to true only on an isolated public demo deployment. Enables the
# documented demo accounts and the one-click demo sign-in buttons.
DEMO_MODE="true"

# Seed guard. The seed script refuses production URLs unless both values
# are present and the deployment is an isolated demo.
DEMO_DEPLOYMENT="false"

# Optional. Local demonstration only. Never set this in production.
# SESSION_COOKIE_SECURE="false"
